{
  "name": "vcard-app",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "migrate:latest": "npm run db:migrate --workspace server",
    "dev": "npm run migrate:latest && npm run dev --workspaces --if-present",
    "build": "rimraf dist && npm run build --workspaces --if-present && npm run migrate:latest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^9.20.0",
    "@types/node": "^26.1.2",
    "@typescript-eslint/parser": "^8.66.0",
    "commitlint": "^19.0.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.0",
    "husky": "^9.1.0",
    "prettier": "^3.5.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.66.0"
  },
  "engines": {
    "node": ">=20"
  }
}
