{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../",
    "outDir": "../dist",
    "paths": {
      "@/*": ["./src/*"],
      "@server/*": ["./src/*"],
      "@shared/*": ["../shared/src/*"]
    }
  },
  "include": [
    "src/**/*",
    "knexfile.ts",
    "../shared/src/**/*",
    "../client/src/utils/pdfStyles.ts",
    "../shared/src/AppError.ts"
  ],
  "exclude": ["node_modules", "../**/node_modules", "../dist"]
}
