{
  "name": "server",
  "private": true,
  "type": "commonjs",
  "main": "./src/server.ts",
  "scripts": {
    "dev": "nodemon --watch src --ext ts,json --exec \"node --loader ts-node/esm src/index.ts\"",
    "build": "tsc",
    "start": "node dist/server/index.js",
    "db:migrate": "node --import tsx --env-file=../.env ../node_modules/knex/bin/cli.js migrate:latest",
    "migrate:make": "node --import tsx --env-file=../.env ../node_modules/knex/bin/cli.js migrate:make",
    "migrate:rollback": "node --import tsx --env-file=../.env ../node_modules/knex/bin/cli.js migrate:rollback"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "hono": "^4.7.0",
    "knex": "^3.3.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "tsx": "^4.23.8"
  }
}
