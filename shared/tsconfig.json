{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../dist/shared",
    "rootDir": "./src",
    "noEmit": false,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "src/AppError.ts"],
  "exclude": ["node_modules", "dist"]
}
