{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "rootDir": "../",
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["./../shared/src/*"]
    },
    "jsx": "react-jsx",
    "types": ["vite/client", "jest"]
  },
  "include": ["src/**/*", "vite.config.ts", "index.html", "../shared/src/**/*"],
  "exclude": ["node_modules", "../**/node_modules", "dist"]
}
