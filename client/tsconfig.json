{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../dist/client",
    "rootDir": "./src",
    "noEmit": false,
    "composite": true,
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../../shared/src/*"]
    },
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
